# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=geo_mushrooms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# API Configuration
PORT=3000
# Host port the app is served on. Change it if something already holds port 80.
HTTP_PORT=80
# Allowed CORS origin for the API (read by main.ts). Point at the client URL.
FRONTEND_URL=http://localhost:4200

# Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_and_random_secret_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password_123

# Client Configuration (Angular)
# The Angular app's API URL is configured in the environment files:
# - Development: apps/client/src/environments/environment.ts
# - Production:  apps/client/src/environments/environment.prod.ts
# Change the apiUrl value in those files for your environment.

# Node Environment
NODE_ENV=development

# Demo data
# Writes the synthetic dataset (areas, cities, ~180 days per city, an admin user)
# when the database is empty. Only the exact value "true" enables it, and it is
# skipped whenever cities already exist.
SEED_DEMO_DATA=true

# Dev Tools
# Enables developer-only actions such as deleting today's scraped data from the UI/API.
# Only the exact value "true" enables it (fail-closed). MUST be false in production.
ENABLE_DEV_TOOLS=false
